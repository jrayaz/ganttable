{
  "name": "ganttable",
  "version": "0.5.0",
  "description": "Gantt chart from a Markdown table: WBS rollups, dependencies, critical path, drag to edit, print preview and SVG or PNG export. Works for project plans and study plans.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "gantt",
    "wbs",
    "project-management"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
